<?xml version="1.0" encoding="utf-8"?>
<!--
    Grille de scan "rayon X" : lignes bleu Vista très légères espacées régulièrement.
    Utilise des positions en dp (approximatives) pour compatibilité layer-list.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000F53FA" />
        </shape>
    </item>
    <item android:top="60dp">
        <shape android:shape="rectangle"><size android:height="1dp"/><solid android:color="#220F53FA"/></shape>
    </item>
    <item android:top="120dp">
        <shape android:shape="rectangle"><size android:height="1dp"/><solid android:color="#220F53FA"/></shape>
    </item>
    <item android:top="180dp">
