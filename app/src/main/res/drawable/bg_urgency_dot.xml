<?xml version="1.0" encoding="utf-8"?>
<!--
    Pastille "vivante" pour les tickets prioritaires :
    un petit rond corail avec un halo pour bien attirer l'œil.
    Utilisée par-dessus la carte du ticket, animée en pulsation continue.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF6B4A" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/vista_coral" />
        </shape>
    </item>
</layer-list>
