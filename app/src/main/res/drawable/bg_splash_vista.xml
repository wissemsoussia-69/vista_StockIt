<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen "Vista" : logo Vistaprint centré sur fond bleu Vista.
    Fonctionne à l'ancienne (windowBackground) sur toutes les versions
    et cohabite bien avec le SplashScreen API sur Android 12+.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vista_blue" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap
            android:src="@mipmap/ic_launcher"
            android:tileMode="disabled" />
    </item>
</layer-list>
