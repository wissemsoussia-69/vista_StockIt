<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen "Vista" : logo Vistaprint centré sur fond bleu Vista.
    Fonctionne à l'ancienne (windowBackground) sur toutes les versions
    et cohabite bien avec le SplashScreen API sur Android 12+.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vista_blue" />
        </shape>
    </item>
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
