<?xml version="1.0" encoding="utf-8"?>
<!--
    Bouton torche : cercle en verre dépoli (blanc semi-transparent + stroke bleu Vista).
    -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#CCFFB020" />
            <stroke android:width="1dp" android:color="@color/vista_amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
