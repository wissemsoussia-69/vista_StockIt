<?xml version="1.0" encoding="utf-8"?>
<!--
    Halo radial derrière l'avatar du hero — donne une profondeur premium
    en évoquant un "spotlight" turquoise très diffus.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:startColor="#661DE9B6"
        android:endColor="#001DE9B6"
        android:centerX="0.5"
        android:centerY="0.5"
        android:gradientRadius="80" />
</shape>
