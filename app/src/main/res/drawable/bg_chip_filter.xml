<?xml version="1.0" encoding="utf-8"?>
<!-- Fond du chip filtre : bleu Vista actif, verre passif. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/vista_blue" />
            <stroke android:width="1dp" android:color="@color/vista_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/vista_surface" />
            <stroke android:width="1dp" android:color="@color/vista_glass_stroke" />
        </shape>
    </item>
</selector>
