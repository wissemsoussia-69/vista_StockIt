<?xml version="1.0" encoding="utf-8"?>
<!-- TM-09 : rien de l'app (base Room, préférences, outbox) ne quitte l'appareil
     via Android Backup / Device Transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
