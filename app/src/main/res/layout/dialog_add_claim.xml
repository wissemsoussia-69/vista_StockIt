<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/claims_new_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00AEEF"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editClaimSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/claims_subject_hint"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editClaimDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/claims_desc_hint"
        android:minLines="3"
        android:gravity="top"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/claims_priority_label"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerClaimPriority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/priorities"
        android:layout_marginBottom="16dp" />

</LinearLayout>
