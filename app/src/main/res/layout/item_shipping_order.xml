<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/shipCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nom Client"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/shipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ship_status_pending"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="#FFC107"
                android:textColor="#000000" />
        </LinearLayout>

        <TextView
            android:id="@+id/shipItemsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_article"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/shipTicketNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ship_ticket_label"
            android:textSize="12sp"
            android:textColor="#E67E22" />

        <TextView
            android:id="@+id/shipTracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ship_tracking_label"
            android:textSize="12sp"
            android:textColor="#00AEEF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnJira"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:text="JIRA"
                android:backgroundTint="#0052CC"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/btnLabel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_save"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#2C3E50" />

            <ImageButton
                android:id="@+id/btnPrepare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#00AEEF" />

            <ImageButton
                android:id="@+id/btnDeleteShip"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#E74C3C" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
