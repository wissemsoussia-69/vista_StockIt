<?xml version="1.0" encoding="utf-8"?>
<!--
    Carte ticket "Vista Glassmorphism" :
    - Bloc blanc avec ombre bleu Vista très subtile
    - Coins doux, texte en dark navy
    - Pastille de priorité colorée (corail = urgence)
    - Petit dot corail animé (pulse) pour les tickets prioritaires
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/vista_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:cardPreventCornerOverlap="true"
        android:foreground="@drawable/ripple_vista"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- Barre de priorité colorée (bord gauche) -->
            <View
                android:id="@+id/itemTicketPriorityBar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_priority_bar"
                android:backgroundTint="@color/vista_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/itemTicketKey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.02"
                        android:text="ETXTUN-42"
                        android:textColor="@color/vista_blue"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/itemTicketPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_priority_pill_medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Medium"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/itemTicketSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="Summary…"
                    android:textAppearance="@style/TextAppearance.Vista.CardTitle" />

                <TextView
                    android:id="@+id/itemTicketDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingTop="4dp"
                    android:text=""
                    android:textColor="@color/vista_navy_muted"
                    android:textSize="12sp" />

                <!-- Ligne footer : avatar + meta + chip SLA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/itemTicketAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/itemTicketMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Backlog"
                        android:textColor="@color/vista_navy_faint"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/itemTicketSla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_navy"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text=""
                        android:textColor="@color/vista_navy"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Pastille corail "vivante" pour les tickets prioritaires,
         activée par TicketAdapter (pulse continu). -->
    <View
        android:id="@+id/itemTicketUrgencyDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_urgency_dot"
        android:visibility="gone" />

</FrameLayout>

