<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/movementTypeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"
                android:text="📥" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/movementProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_article"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/movementDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01/01/2024 12:00"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <TextView
                android:id="@+id/movementQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/art_table_qty"
                android:textStyle="bold"
                android:textColor="#00AEEF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="8dp" />

        <TextView
            android:id="@+id/movementUserDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_name_me"
            android:textSize="13sp"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/movementReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/art_reason_label"
            android:textSize="13sp"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/movementComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mov_label_comment"
            android:textSize="13sp"
            android:textColor="#888888"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
