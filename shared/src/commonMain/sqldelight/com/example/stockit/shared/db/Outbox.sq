-- File d'attente des appels webhook échoués (réseau coupé, workflow n8n inactif…).
CREATE TABLE outbox (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    url TEXT NOT NULL,
    body TEXT NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    lastError TEXT,
    createdAt INTEGER NOT NULL
);

insert:
INSERT INTO outbox(url, body, attempts, lastError, createdAt) VALUES (?, ?, 0, ?, ?);

pending:
SELECT * FROM outbox WHERE attempts < 20 ORDER BY id ASC LIMIT 50;

markFailed:
UPDATE outbox SET attempts = attempts + 1, lastError = ? WHERE id = ?;

delete:
DELETE FROM outbox WHERE id = ?;

count:
SELECT COUNT(*) FROM outbox WHERE attempts < 20;
