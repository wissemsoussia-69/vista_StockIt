CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    password TEXT NOT NULL,
    role TEXT NOT NULL,
    points INTEGER NOT NULL DEFAULT 0,
    level INTEGER NOT NULL DEFAULT 1,
    badges TEXT NOT NULL DEFAULT ''
);

login:
SELECT * FROM users WHERE username = ? AND password = ? LIMIT 1;

-- Équivalent Room @Insert(onConflict = REPLACE)
register:
INSERT OR REPLACE INTO users(username, password, role, points, level, badges) VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE users SET username = ?, password = ?, role = ?, points = ?, level = ?, badges = ? WHERE id = ?;

getAll:
SELECT * FROM users;

findByUsername:
SELECT * FROM users WHERE username = ? COLLATE NOCASE LIMIT 1;

count:
SELECT COUNT(*) FROM users;

delete:
DELETE FROM users WHERE id = ?;
