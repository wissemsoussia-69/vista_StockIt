# StockIT PFE — Modèle d'environnement (Linux / macOS / Git Bash).
#
# 1. Copier ce fichier :   cp .env.sh.example .env.sh
# 2. Remplir les valeurs ci-dessous avec VOS propres clés.
# 3. Sourcer avant de builder :   source .env.sh && ./gradlew installDebug
#
# ⚠  .env.sh est ignoré par git (voir .gitignore). NE JAMAIS committer les vraies clés.

# --- Cimpress Gateway (passerelle IA Vistaprint) ---
export CIMPRESS_GATEWAY_KEY=""
export GATEWAY_URL="https://gateway.ai.cimpress.io/v1"
export CIMPRESS_VISION_MODEL="@Anthropic/eu.anthropic.claude-opus-4-8"

# --- Portkey (secondaire, fallback si Cimpress KO) ---
export PORTKEY_API_KEY=""
export GEMINI_API_KEY=""

# --- Slack (Incoming Webhook) ---
export SLACK_WEBHOOK_URL=""

# --- Jira Cloud REST v3 ---
export JIRA_USER_EMAIL=""
export JIRA_API_TOKEN=""
export JIRA_BASE_URL="https://your-org.atlassian.net"
export JIRA_PROJECT_KEY=""
export JIRA_ISSUE_TYPE="Hardware request"
export JIRA_COST_CENTER=""
export JIRA_COMPONENT=""

# --- Hugging Face (fallback vision) ---
export HUGGING_FACE_TOKEN=""

# --- SendGrid (email notifications) ---
export SENDGRID_API_KEY=""

# --- Slack bot (chat programmatique) ---
export SLACK_BOT_TOKEN=""

# --- Webhook interne StockIT (n8n / automation.vista.io) ---
export STOCKIT_WEBHOOK_URL=""
export STOCKIT_WEBHOOK_SECRET=""

echo "[StockIT] Variables d'environnement chargées."
