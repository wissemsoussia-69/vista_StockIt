# =============================================================================
#  StockIT — configuration (MODÈLE). Copier puis remplir :   cp .env.sh.example .env.sh
#  .env.sh est ignoré par git : vos vraies valeurs ne sont jamais publiées.
#  Lu automatiquement à chaque build (Xcode ⌘R / Gradle). Après modification : ⇧⌘K puis ⌘R.
# =============================================================================

# --- IA option A : passerelle Cimpress / Portkey (scan, factures, étiquettes, assistant, rapport PDF)
export GATEWAY_URL="https://gateway.example.com/v1"
export CIMPRESS_GATEWAY_KEY=""
export CIMPRESS_VISION_MODEL="@Anthropic/eu.anthropic.claude-opus-4-8"

# --- IA option B : Claude direct (utilisé si la clé de passerelle est vide)
export CLAUDE_API_KEY=""
export CLAUDE_MODEL="claude-3-5-sonnet-latest"

# --- E-mail destinataire par défaut des alertes (workflow n8n)
export STOCKIT_DEFAULT_EMAIL="stock-manager@example.com"

# --- Auth0 / Okta (SSO)
export AUTH0_DOMAIN="your-tenant.auth0.com"
export AUTH0_CLIENT_ID=""
export AUTH0_CONNECTION=""
export AUTH0_CALLBACK_URL="com.example.stockit://your-tenant.auth0.com/ios/com.example.stockit/callback"
export AUTH0_LOGOUT_URL="stockit://logout"
export AUTH0_AUDIENCE=""
# Rôle des employés SSO sans groupe StockIT : USER (lecture seule), MANAGER, ADMIN
export STOCKIT_SSO_DEFAULT_ROLE="MANAGER"

# --- Jira Cloud
export JIRA_BASE_URL="https://your-company.atlassian.net"
export JIRA_PROJECT_KEY="SD"
export JIRA_USER_EMAIL=""
export JIRA_API_TOKEN=""
export JIRA_ISSUE_TYPE="IT Help"
export JIRA_COMPONENT=""
export JIRA_COST_CENTER=""
# Jira Assets (CMDB) : schéma et types d'objets
export JIRA_ASSETS_SCHEMA_ID=""
export JIRA_ASSETS_TYPE_PERIPHERALS=""
export JIRA_ASSETS_TYPE_COMPUTERS=""
export JIRA_ASSETS_TYPE_MONITORS=""
export JIRA_ASSETS_LOCATION=""

# --- Automatisations n8n
export STOCKIT_WEBHOOK_URL="https://n8n.example.com/webhook/stockit/send"
export STOCKIT_EVENT_WEBHOOK_URL="https://n8n.example.com/webhook/stockit/event"
export STOCKIT_ASSET_STATUS_WEBHOOK_URL="https://n8n.example.com/webhook/stockit/asset-status"
export STOCKIT_SLACK_WEBHOOK_URL="https://n8n.example.com/webhook/stockit/slack"
export STOCKIT_WEBHOOK_SECRET=""

# --- Slack (facultatif)
export SLACK_WEBHOOK_URL=""
export SLACK_BOT_TOKEN=""
export SLACK_CHANNEL_ID=""

# --- Backend réclamations (facultatif) — vide = réclamations enregistrées sur le téléphone
export STOCKIT_API_BASE_URL=""

# --- Non utilisés
export PORTKEY_API_KEY=""
export GEMINI_API_KEY=""
export HUGGING_FACE_TOKEN=""
export SENDGRID_API_KEY=""
